# ====================================================================
# Lenovo LOQ Control - Regras UDEV para Acesso sem Sudo
# Permite escrita nos nós de ACPI, perfis e conservação de bateria
# ====================================================================

# Permissão para o perfil de plataforma ACPI (Quiet, Balanced, Performance)
ACTION=="add|change", SUBSYSTEM=="acpi", RUN+="/bin/chmod 0666 /sys/firmware/acpi/platform_profile"
ACTION=="add|change", SUBSYSTEM=="platform", RUN+="/bin/sh -c 'chmod 0666 /sys/firmware/acpi/platform_profile 2>/dev/null || true'"

# Permissão para o driver Lenovo Ideapad ACPI (VPC2004)
ACTION=="add|change", SUBSYSTEM=="platform", KERNEL=="VPC2004:00", RUN+="/bin/sh -c 'chmod 0666 /sys/devices/platform/VPC2004:00/conservation_mode /sys/bus/platform/drivers/ideapad_acpi/VPC2004:00/conservation_mode /sys/bus/platform/drivers/ideapad_acpi/VPC2004:00/fn_lock /sys/bus/platform/drivers/ideapad_acpi/VPC2004:00/camera_power /sys/bus/platform/drivers/ideapad_acpi/VPC2004:00/fan_mode 2>/dev/null || true'"

# Fallback genérico para caminhos ideapad_laptop / ideapad_acpi
ACTION=="add", SUBSYSTEM=="module", KERNEL=="ideapad_laptop", RUN+="/bin/sh -c 'chmod 0666 /sys/bus/platform/drivers/ideapad*/*/conservation_mode /sys/bus/platform/drivers/ideapad*/*/fn_lock 2>/dev/null || true'"

